#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * The dependency-licence check.
 *
 * One `composer licenses --locked --no-dev --format=json` pass, two assertions:
 *
 *   1. every production dependency declares at least one licence on the
 *      allowlist, and
 *   2. THIRD-PARTY-LICENCES.md is what that pass produces.
 *
 * Both answer one question -- is the licence position of this tree what the
 * repository says it is? -- so they are one gate. The division of labour is
 * this repository's own taxonomy: an inventory diff somebody has to read and
 * notice GPL in is an aid; the allowlist is what makes it a gate.
 *
 * Unlike bin/check-provenance, this runs *inside* the composed stack. It needs
 * Composer, and Composer needs PHP, so there is no host-only version of it to
 * write. `make licence` supplies the container; the Makefile is the only place
 * that knows about Docker.
 *
 * PHP rather than POSIX sh for one reason: the payload is JSON and there is no
 * jq in the image. Parsing it in sh would mean a regex over a structure, which
 * is the kind of cleverness that fails silently on the one input that matters.
 *
 * --locked is load-bearing. Reading the committed lockfile rather than the
 * installed tree means a transitive licence change can only reach main through
 * a lock change -- that is, through a pull request -- so the gate catches it at
 * the moment it is proposed rather than whenever somebody next runs
 * `composer update`. It also makes the check runnable with nothing installed.
 *
 * --no-dev is a decision, not an omission. Dev tooling is never combined into
 * the conveyed work, so the inbound/outbound compatibility question does not
 * reach it. See ADR 3.
 *
 * Two traps, both measured before this was written. See
 * https://github.com/marcth-labs/proving-ground/issues/28.
 *
 *   The disjunction. A check written the obvious way -- *every* declared
 *   licence must be allowlisted -- refuses stock Laravel 13 on its first run,
 *   because nette/utils and nette/schema each declare
 *   ["BSD-3-Clause","GPL-2.0-only","GPL-3.0-only"] in the production tree and
 *   reach it through laravel/framework -> league/commonmark -> league/config.
 *   That array is Composer's documented disjunctive form -- "when there is a
 *   choice between licenses ("disjunctive license"), multiple can be specified
 *   as an array" (doc/04-schema.md, SS license) -- so the rule is ANY ONE
 *   MATCH. The natural "fix" of allowlisting GPL-3.0-only would reach green by
 *   silently permitting a genuinely GPL-only package: a wrong green arrived at
 *   by repairing a wrong red, the same shape as PAO_DISABLE.
 *
 *   The expression. Composer also documents a conjunctive form, "(A and B)",
 *   and permits "(A or B)". Either arrives here as a single array element that
 *   is not a bare SPDX identifier, so it matches nothing and the package is
 *   refused. LEAVE IT REFUSING. Teaching this script to parse expressions
 *   would mean a disjunctive parser, and a disjunctive parser applied to a
 *   conjunctive expression accepts a package on a licence it only half
 *   carries. A refusal costs one ticket; that costs the claim.
 *
 * Composer's machine-readable schema does not encode any of this: res/composer
 * -schema.json defines `license` as {"type": ["string","array"]} and says
 * nothing about disjunction. The semantics live in prose only and no tooling
 * enforces them, which is why this script prints the licence it accepted each
 * package under instead of passing silently.
 */

const ALLOWLIST = ['MIT', 'BSD-3-Clause', 'Apache-2.0'];

const INVENTORY = 'THIRD-PARTY-LICENCES.md';

const EXIT_OK = 0;
const EXIT_FAIL = 1;
const EXIT_USAGE = 2;

$root = dirname(__DIR__);
$inventoryPath = $root.'/'.INVENTORY;

$write = false;

foreach (array_slice($argv, 1) as $arg) {
    match ($arg) {
        '--write' => $write = true,
        default => usage(),
    };
}

function usage(): never
{
    fwrite(STDERR, <<<USAGE
    usage: check-licences [--write]

      (no flags)  check: refuse a dependency off the allowlist, and fail on
                  drift between THIRD-PARTY-LICENCES.md and the lockfile
      --write     regenerate THIRD-PARTY-LICENCES.md instead of checking it

    Runs inside the composed stack; `make licence` is the usual caller.

    USAGE);

    exit(EXIT_USAGE);
}

function fail(string $message): never
{
    fwrite(STDERR, "\ncheck-licences: $message\n");

    exit(EXIT_FAIL);
}

/**
 * Run `composer licenses` and return its decoded payload.
 *
 * stdout and stderr are kept apart deliberately: Composer writes warnings to
 * stderr, and folding them into stdout would corrupt the JSON and surface as a
 * parse error rather than as the warning it is.
 */
function composerLicences(string $root): array
{
    $command = ['composer', 'licenses', '--locked', '--no-dev', '--format=json', '--working-dir='.$root];

    $process = proc_open(
        $command,
        [1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
        $pipes,
    );

    if ($process === false) {
        fail('could not run composer; this script runs inside the stack -- try `make licence`');
    }

    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    array_map(fclose(...), $pipes);
    $status = proc_close($process);

    if ($status !== 0) {
        fail("composer licenses exited $status\n".trim($stderr));
    }

    try {
        $payload = json_decode($stdout, true, flags: JSON_THROW_ON_ERROR);
    } catch (JsonException $e) {
        fail('composer licenses did not return JSON: '.$e->getMessage());
    }

    if (! is_array($payload) || ! is_array($payload['dependencies'] ?? null)) {
        fail('composer licenses returned no `dependencies` map; the payload shape has changed');
    }

    return $payload['dependencies'];
}

/**
 * The first declared licence that is on the allowlist, or null for a refusal.
 *
 * Any one match. See the disjunction trap in the header.
 */
function acceptedUnder(array $declared): ?string
{
    foreach ($declared as $licence) {
        if (in_array($licence, ALLOWLIST, true)) {
            return $licence;
        }
    }

    return null;
}

function renderInventory(array $rows): string
{
    $allowlist = implode('`, `', ALLOWLIST);

    $table = '';

    foreach ($rows as $row) {
        $table .= sprintf(
            "| `%s` | %s | %s | %s |\n",
            $row['name'],
            $row['version'],
            implode(', ', $row['declared']),
            $row['accepted'],
        );
    }

    return <<<MARKDOWN
    # Third-party licences

    **Generated. Do not edit.** Produced by
    [`bin/check-licences`](bin/check-licences) from
    `composer licenses --locked --no-dev`, and drift-checked by `make licence`:
    if this file and `composer.lock` disagree, the gate fails. Regenerate it
    with `make licence-write`.

    **This is an inventory, not a NOTICE,** and the distinction is not
    pedantry. `composer licenses` reports a package's name, version and
    declared licences and nothing else — no copyright holders, no licence
    texts, no URLs — so this file cannot discharge an attribution obligation
    and does not claim to. None is triggered: `vendor/` is untracked and
    nothing here publishes an image, so what this repository conveys is a
    lockfile *naming* these libraries rather than the libraries themselves.
    The full-text version becomes correct the day something is actually
    redistributed.

    **Production dependencies only** (`--no-dev`), because dev tooling is never
    combined into the conveyed work. The reasoning, and the outbound licence
    these are checked against, are in
    [ADR 3](docs/adr/0003-outbound-licence-and-the-dependency-allowlist.md).

    ## Allowlist

    `$allowlist`

    A package passes on **any one** declared licence matching — Composer's
    documented disjunctive form — which is why the *Accepted under* column
    exists, and why the GPL strings below are visible rather than quietly
    filtered out. Nothing here is GPL-encumbered: `nette/utils` and
    `nette/schema` offer a choice, and this tree takes BSD-3-Clause.

    ## Dependencies

    | Package | Version | Declared | Accepted under |
    |---|---|---|---|
    $table
    MARKDOWN;
}

$dependencies = composerLicences($root);

ksort($dependencies, SORT_STRING);

$rows = [];
$refusals = [];

foreach ($dependencies as $name => $package) {
    if (! is_array($package['license'] ?? null) || ! is_string($package['version'] ?? null)) {
        fail("composer licenses returned an unexpected entry for `$name`; the payload shape has changed");
    }

    $declared = $package['license'];
    $accepted = acceptedUnder($declared);

    if ($accepted === null) {
        $refusals[] = $declared === []
            ? "$name: REFUSED, declares no licence"
            : "$name: REFUSED, declares ".implode(', ', $declared);

        continue;
    }

    printf("  %s: accepted under %s\n", $name, $accepted);

    $rows[] = [
        'name' => $name,
        'version' => $package['version'],
        'declared' => $declared,
        'accepted' => $accepted,
    ];
}

/*
 * The root package's own licence is reported by `composer licenses` alongside
 * the dependencies and is deliberately not checked here. The allowlist is the
 * set of *inbound* licences compatible with this repository's outbound one; as
 * of ADR 3 the outbound licence is GPL-3.0-or-later, which is correctly absent
 * from the allowlist. A check that folded the root package in would refuse the
 * repository itself.
 */

if ($refusals !== []) {
    fwrite(STDERR, "\n".implode("\n", array_map(fn (string $r) => "  $r", $refusals))."\n");

    fail(
        count($refusals)." package(s) off the allowlist (`".implode('`, `', ALLOWLIST)."`).\n"
        ."Adding a licence to the allowlist is a decision with a ticket and a pull\n"
        ."request behind it, not a repair. See ADR 3."
    );
}

$inventory = renderInventory($rows);

if ($write) {
    file_put_contents($inventoryPath, $inventory);

    printf("\ncheck-licences: wrote %s (%d packages)\n", INVENTORY, count($rows));

    exit(EXIT_OK);
}

$committed = is_file($inventoryPath) ? file_get_contents($inventoryPath) : null;

if ($committed === null) {
    fail(INVENTORY.' is missing; run `make licence-write` and commit the result');
}

if ($committed !== $inventory) {
    fail(INVENTORY." does not match the lockfile.\nRun `make licence-write` and commit the result.");
}

printf("\ncheck-licences: ok, %d production packages, inventory matches\n", count($rows));
